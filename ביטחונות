<!-- סקריפט ליצירת איש קשר (vCard) בפורמט תקין ומוקפד -->
<script>
    function downloadVCard() {
        // שימוש ב-Template Literals לבניית מחרוזת תקינה
        const vcard = `BEGIN:VCARD
VERSION:3.0
N:לוי;אלדר;הרב;;
FN:הרב אלדר לוי - טוען רבני ודיין
ORG:משרד טוען רבני, גישור וסת"ם
TITLE:טוען רבני, בעל כושר לדיינות, מגשר וסופר סת"ם
TEL;TYPE=CELL:052-8219928
EMAIL:Tifarteha@gmail.com
URL:https://my-rabbinic-website.github.io/ELDAR-LEVI-OFIC2/
NOTE:משרד המעניק שירותי ייצוג בבתי הדין הרבניים, גישור, וכן כתיבת סת"ם. סניפים: נתיבות ובאר שבע.
END:VCARD`;
                      
        const blob = new Blob([vcard], { type: "text/vcard;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.setAttribute('download', 'הרב_אלדר_לוי_טוען_רבני.vcf');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>

